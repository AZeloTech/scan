node_modules/
dist/
*.tsbuildinfo
# assets/ is generated by scripts/build-assets.mjs from node_modules, except the
# dewarp WASM which is a committed build artefact of our own Rust crate.
assets/scanic-ml/
assets/pdfjs/
assets/workers/
assets/scanic/
# Never, ever: photographs of real documents have no home in this repository.
data/
**/parity/fixtures/
*.local
.DS_Store
test-results/
playwright-report/

# The consumer smoke apps build against the real tarball: their installed
# dependencies, their copied assets and their output are all generated.
tests/consumers/*/node_modules/
tests/consumers/*/public/
tests/consumers/*/dist/
tests/consumers/*/out/
tests/consumers/*/.next/
tests/consumers/*/package-lock.json

# The detection bench's synthetic output (reports, contact sheets, the bench
# page's bundle). Generated from seeds on every run; never committed. Anything
# derived from REAL media is written outside the repository altogether.
.bench-out/
